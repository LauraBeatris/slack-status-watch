{
  "display_information": {
    "name": "Status for Slack",
    "description": "Sets your Slack status from an Apple Watch"
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "users.profile:read",
        "users.profile:write"
      ]
    },
    "redirect_urls": [
      "https://status-for-slack.vercel.app/api/slack/callback"
    ]
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
